{
  "info": {
    "name": "Al-Suwaidi Blog API",
    "description": "Complete CRUD API collection for Blog module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Blog",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "heading", "value": "My First Blog", "type": "text" },
            { "key": "description", "value": "Ye mera pehla blog hai Al-Suwaidi ke baare mein", "type": "text" },
            { "key": "author", "value": "Vivek", "type": "text" },
            { "key": "tags", "value": "tech,news,update", "type": "text" },
            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/blog/create",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["blog", "create"]
        },
        "description": "Create a new blog with image upload (JPG/PNG/WEBP, max 5MB)"
      }
    },
    {
      "name": "Get All Blogs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/blog/get",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["blog", "get"]
        },
        "description": "Fetch all blogs sorted by latest first"
      }
    },
    {
      "name": "Get Single Blog",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/blog/get/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["blog", "get", ":id"],
          "variable": [
            { "key": "id", "value": "BLOG_ID_YAHAN_DAALO", "description": "MongoDB Blog ID" }
          ]
        },
        "description": "Fetch single blog by MongoDB ID"
      }
    },
    {
      "name": "Update Blog",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"heading\": \"Updated Blog Heading\",\n  \"description\": \"Updated description hai yeh\",\n  \"author\": \"Vivek Raj\",\n  \"tags\": \"tech,update\",\n  \"isPublished\": true\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "http://localhost:5000/blog/update/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["blog", "update", ":id"],
          "variable": [
            { "key": "id", "value": "BLOG_ID_YAHAN_DAALO", "description": "MongoDB Blog ID" }
          ]
        },
        "description": "Update blog fields. Image update ke liye formdata use karo"
      }
    },
    {
      "name": "Update Blog With Image",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "heading", "value": "Updated Heading", "type": "text" },
            { "key": "description", "value": "Updated description", "type": "text" },
            { "key": "author", "value": "Vivek", "type": "text" },
            { "key": "tags", "value": "tech,update", "type": "text" },
            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/blog/update/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["blog", "update", ":id"],
          "variable": [
            { "key": "id", "value": "BLOG_ID_YAHAN_DAALO", "description": "MongoDB Blog ID" }
          ]
        },
        "description": "Update blog along with new image (old image auto delete hogi)"
      }
    },
    {
      "name": "Delete Blog",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/blog/delete/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["blog", "delete", ":id"],
          "variable": [
            { "key": "id", "value": "BLOG_ID_YAHAN_DAALO", "description": "MongoDB Blog ID" }
          ]
        },
        "description": "Delete blog by ID (image file bhi delete hogi)"
      }
    }
  ]
}
